        SUBT Exported AcornSSL constants

OldOpt  SETA    {OPT}
        OPT     OptNoList+OptNoP1List

SWIClass        SETS    AcornSSLSWI_Name

        ^       AcornSSLSWI_Base

        AddSWI  Creat
        AddSWI  Ioctl
        AddSWI  Connect
        AddSWI  Shutdown
        AddSWI  Close
        AddSWI  Getsockopt
        AddSWI  Write
        AddSWI  Recv
        AddSWI  CreateSession
        AddSWI  Getpeername
        AddSWI  Getsockname
        AddSWI  Setsockopt
        AddSWI  Stat
        AddSWI  Version
        AddSWI  ConfigureSession
        AddSWI  Read
        AddSWI  Send

; Create session flags
                        ^ 0
CreateSession_New       # 1
CreateSession_ReuseAuth # 1
CreateSession_CmdMask   * &FF
CreateSession_CmdShift  * 0
CreateSession_FlagMask  * &FFFFFF
CreateSession_FlagShift * 8

; Extension socket options to getsockopt() and setsockopt()
                        ^ &11E0
SO_ACORNSSL_HOSTNAME    # 1
SO_ACORNSSL_PROMPTTIME  # 1

; Certificate chain tag entries
                        ^ 0
CertTag_ListEnd         # 1
CertTag_Issuer          # 1
CertTag_Subject         # 1
CertTag_ValidFrom       # 1
CertTag_ValidTo         # 1
CertTag_Serial          # 1
CertTag_Version         # 1
CertTag_Signature       # 1
CertTag_X509            # 1

; Certificate chain tag types
                        ^ 0
CertTagType_String      # 1
CertTagType_Integer     # 1
CertTagType_Cardinal    # 1
CertTagType_UnixTime    # 1
CertTagType_Pointer     # 1

        OPT     OldOpt
        END
