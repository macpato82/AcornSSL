        GET     Hdr:ListOpts
        GET     Hdr:Macros
        GET     Hdr:System

        IMPORT  main
        EXPORT  sslmod_enter

        AREA    |confirmenter$$Data|, DATA, NOINIT

        ; Our Wimp task's stack, put in the ZI region so it gets
        ; released along with all the other module workspace on finalisation
sslmod_appstack
        SPACE   16384
sslmod_appstacktop

        AREA    |confirmenter$$Code|, CODE, READONLY

        ; Entry r0  = command tail
        ;       r12 = private word
        ; Exit  r0  = return code from main()
sslmod_enter
        LDR     a4, =sslmod_appstack
        LDR     ip, [r12]
        LDMIB   ip, { a2-a3 }           ; Get lib & client relocation offsets
        ADD     a4, a4, a3
        STMIA   a4, { a2-a3 }           ; Copy to bottom of stack

        ; Enter APCS main()
        ADD     sl, a4, #540            ; Stack limit clear of the relocation offsets
                                        ; so -536 and -540 pick them up
        MOV     fp, #0                  ; Stop backtrace here
        ADD     sp, a4, #16384
        Push    "a1"
        MOV     a2, sp                  ; Minimal valid argc and argv
        MOV     a1, #1
        BL      main

        SWI     OS_Exit

        END
