/*!
 * \param  ext Opaque SSL handle from AcornSSL_Creat or AcornSSL_CreateSession
 * \param  level As for Socket_Getsockopt
 * \param  optname As for Socket_Getsockopt
 * \param  optval As for Socket_Getsockopt
 * \param  optlen As for Socket_Getsockopt
 * \param  result Pointer to return result as for Socket_Getsockopt
 * \return Pointer to error block
 */
_kernel_oserror *api_getsockopt(int ext, int level, int optname, void *optval, int *optlen,
                                int *result)
{
	sslhandle_t     *h;
	_kernel_oserror *err;

	err = find_sslhandle(ext, &h);
	if (err == NULL)
	{
		if ((optname == SO_ACORNSSL_HOSTNAME) && (level == SOL_SOCKET))
		{
			/* Session host name */
			if (*optlen != sizeof(char *))
			{
				*result = -1;
				err = intl_error(ERR08_PARAMETER_ERROR, intl_integer(EINVAL));
			}
			else
			{
				*result = ESUCCESS;
				*(char **)optval = h->ssl.hostname;
			}
			return err;
		}
		if ((optname == SO_ACORNSSL_PROMPTTIME) && (level == SOL_SOCKET))
		{
			/* Prompt timeout in centiseconds for flagged certificates */
			if (*optlen != sizeof(uint32_t))
			{
				*result = -1;
				err = intl_error(ERR08_PARAMETER_ERROR, intl_integer(EINVAL));
			}
			else
			{
				*result = ESUCCESS;
				*(uint32_t *)optval = h->confirmmax;
			}
			return err;
		}
		*result = getsockopt(h->net.fd, level, optname, optval, optlen);
		if (*result == -1)
		{
			err = &_inet_error;
		}
		else
		{
			if (*optlen == sizeof(int)) dprintf(("api", "value %d from ", *(int *)optval));
			dprintf(("api", "getsockopt %d on %p\n", optname, (void *)h));
		}
	}

	return err;
}

/*!
 * \param  ext Opaque SSL handle from AcornSSL_Creat or AcornSSL_CreateSession
 * \param  level As for Socket_Setsockopt
 * \param  optname As for Socket_Setsockopt
 * \param  optval As for Socket_Setsockopt
 * \param  optlen As for Socket_Setsockopt
 * \param  result Pointer to return result as for Socket_Setsockopt
 * \return Pointer to error block
 */
_kernel_oserror *api_setsockopt(int ext, int level, int optname, const void *optval, int optlen,
                                int *result)
{
	sslhandle_t     *h;
	_kernel_oserror *err;

	err = find_sslhandle(ext, &h);
	if (err == NULL)
	{
		if ((optname == SO_ACORNSSL_HOSTNAME) && (level == SOL_SOCKET))
		{
			int mbederr;

			/* Session host name */
			if (optlen != sizeof(const char *))
			{
				*result = -1;
				err = intl_error(ERR08_PARAMETER_ERROR, intl_integer(EINVAL));
			}
			else
			{
				*result = ESUCCESS;
				mbederr = mbedtls_ssl_set_hostname(&h->ssl, (const char *)optval);
				if (mbederr < 0)
				{
					*result = -1;
					if (mbederr == MBEDTLS_ERR_SSL_ALLOC_FAILED)
					{
						return intl_error(ERR05_MALLOC, NULL);
					}

					/* Treat everything else as invalid parameter */
					err = intl_error(ERR08_PARAMETER_ERROR, intl_integer(EINVAL));
					REALLYSETDCI4ERRNO(err->errnum, EINVAL);
				}
			}
			return err;
		}
		if ((optname == SO_ACORNSSL_PROMPTTIME) && (level == SOL_SOCKET))
		{
			/* Prompt timeout in centiseconds for flagged certificates */
			if (optlen != sizeof(uint32_t))
			{
				*result = -1;
				err = intl_error(ERR08_PARAMETER_ERROR, intl_integer(EINVAL));
			}
			else
			{
				*result = ESUCCESS;
				h->confirmmax = *(uint32_t *)optval;
			}
			return err;
		}
		*result = setsockopt(h->net.fd, level, optname, optval, optlen);
		if (*result == -1)
		{
			err = &_inet_error;
		}
		else
		{
			if (optlen == sizeof(int)) dprintf(("api", "value %d to ", *(const int *)optval));
			dprintf(("api", "setsockopt %d on %p\n", optname, (void *)h));
		}
	}

	return err;
}

