/*!
 * \param  ext Opaque SSL handle from AcornSSL_Creat or AcornSSL_CreateSession
 * \param  result Pointer to return result as for Socket_Close
 * \return Pointer to error block
 */
_kernel_oserror *api_close(int ext,
                           int *result)
{
	sslhandle_t     *h;
	_kernel_oserror *err;

	err = find_sslhandle(ext, &h);
	if (err == NULL)
	{
		mbedtls_ssl_close_notify(&h->ssl);
		*result = h->clientsocket ? 0
		                          : socketclose(h->net.fd);
		if (*result == -1)
		{
			err = &_inet_error;
		}
		else
		{
			/* Also dispose of the memory associated with the handle */
			dprintf(("api", "close of %p\n", (void *)h));
			h->net.fd = -1;
			err = free_sslhandle(h);
		}
	}

	return err;
}

/*!
 * \param  ext Opaque SSL handle from AcornSSL_Creat or AcornSSL_CreateSession
 * \param  buff As for Socket_Send
 * \param  len As for Socket_Send
 * \param  flags As for Socket_Send
 * \param  result Pointer to return result as for Socket_Write
 * \return Pointer to error block
 */
_kernel_oserror *api_send(int ext, const char *buff, size_t len, int flags,
                          int *result)
{
	sslhandle_t     *h;
	_kernel_oserror *err;
	bool   dontwait, waitall, nbio;

	*result = -1;
	err = find_sslhandle(ext, &h);
	if (err != NULL) return err;
	err = handshake_sslhandle(h);
	if (err != NULL) return err;

	/* Deduce the local message options */
	dontwait = (flags & MSG_DONTWAIT) != 0;
	waitall = (flags & MSG_WAITALL) != 0;
	nbio = (dontwait != waitall) ? dontwait : h->nbio;

	return write_to_sslhandle(h, buff, len, nbio, result);
}

/*!
 * \param  ext Opaque SSL handle from AcornSSL_Creat or AcornSSL_CreateSession
 * \param  buff As for Socket_Recv
 * \param  len As for Socket_Recv
 * \param  flags As for Socket_Recv
 * \param  result Pointer to return result as for Socket_Recv
 * \return Pointer to error block
 */
_kernel_oserror *api_recv(int ext, char *buff, size_t len, int flags,
                          int *result)
{
	sslhandle_t     *h;
	_kernel_oserror *err;
	bool   dontwait, waitall, nbio;

	*result = -1;
	err = find_sslhandle(ext, &h);
	if (err != NULL) return err;
	err = handshake_sslhandle(h);
	if (err != NULL) return err;

	/* Deduce the local message options */
	dontwait = (flags & MSG_DONTWAIT) != 0;
	waitall = (flags & MSG_WAITALL) != 0;
	nbio = (dontwait != waitall) ? dontwait : h->nbio;

	if (flags & MSG_PEEK)
	{
		int      read;
		size_t   available = h->peekto - h->peekfrom;
		uint8_t *newbuffer;

		if (len > available)
		{
			/* Flatten existing buffer */
			memmove(h->peekbuffer, h->peekbuffer + h->peekfrom, available);
			h->peekfrom = 0;
			h->peekto = available;
			dprintf(("gbpb", "peek buffer contains %u bytes, peeking %u\n", available, len));

			/* Grow then fetch into the buffer */
			newbuffer = realloc(h->peekbuffer, len);
			if (newbuffer == NULL)
			{
				return intl_error(ERR05_MALLOC, NULL);
			}
			else
			{
				h->peekbuffer = newbuffer;
				h->peekspace = len;
				err = read_from_sslhandle(h, (char *)h->peekbuffer + available,
				                          len - available, nbio, &read);
				if (available && (read < 0))
				{
					/* The read failed, but there's something buffered. Ignore
					 * the error and instead pass back what little is available.
					 */
					read = 0;
					err = NULL;
				}
				if (err != NULL) return err;
				if (read < 0) return NULL;

				/* Accumulate new peeked data */
				h->peekto += read;
				available += read;
			}
		}

		/* Give as much as possible from previously peeked data */
		len = MIN(len, available);
		memcpy(buff, h->peekbuffer + h->peekfrom, len);
		dprintf(("gbpb", "peeked %d bytes\n", len));
		*result = len;
		err = NULL;
	}
	else
	{
		int    read;
		size_t available = h->peekto - h->peekfrom;
		size_t copy = 0;

		if (available)
		{
			/* Consume from peeked data first */
			copy = MIN(len, available);
			memcpy(buff, h->peekbuffer + h->peekfrom, copy);
			dprintf(("gbpb", "peek buffer contains %u bytes, still want %u\n", available, len - copy));
			h->peekfrom += copy;
			if (h->peekto - h->peekfrom == 0)
			{
				/* All consumed */
				dprintf(("gbpb", "peek buffer became empty\n"));
				free(h->peekbuffer);
				h->peekbuffer = NULL;
				h->peekspace = h->peekto = h->peekfrom = 0;
			}
			if (len == copy)
			{
				*result = copy;
				return NULL;
			}

			/* Need to read the remaining */
			buff += copy;
			len  -= copy;
		}
		err = read_from_sslhandle(h, buff, len, nbio, &read);
		if (copy && (read < 0))
		{
			/* The read failed, but there's something buffered. Ignore
			 * the error and instead pass back what little is available.
			 */
			read = 0;
			err = NULL;
		}
		if (err != NULL) return err;
		if (read < 0) return NULL;

		/* Add to any read earlier */
		*result = copy + read;
	}

	return NULL;
}

/*!
 * \param  ext Opaque SSL handle from AcornSSL_Creat or AcornSSL_CreateSession
 * \param  cmd As for Socket_Ioctl
 * \param  arg As for Socket_Ioctl
 * \param  result Pointer to return result as for Socket_Ioctl
 * \return Pointer to error block
 */
_kernel_oserror *api_ioctl(int ext, unsigned long cmd, void *arg,
                           int *result)
{
	sslhandle_t     *h;
	_kernel_oserror *err;

	err = find_sslhandle(ext, &h);
	if (err == NULL)
	{
		if (cmd == _IOW('f', 126, int))
		{
			/* Track writes to FIONBIO */
			h->nbio = *(int *)arg != 0;
			dprintf(("api", "nbio set to %d on %p\n", h->nbio, (void *)h));
			*result = modify_nonblock(&h->net, h->nbio);
		}
		else
		{
			*result = socketioctl(h->net.fd, cmd, arg);
		}
		if (*result == -1)
		{
			err = &_inet_error;
		}
		else
		{
			dprintf(("api", "ioctl %lu on %p\n", cmd & 0xFF, (void *)h));
		}
	}

	return err;
}

